{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "branchPrefix": "renovate/",
  "prCreation": "immediate",
  "prHourlyLimit": 0,
  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "automerge": false,
      "prConcurrentLimit": 10
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Xcode SPM dependencies declared in project.pbxproj",
      "managerFilePatterns": ["/(^|/)project\\.pbxproj$/"],
      "matchStrings": [
        "repositoryURL = \"https://github\\.com/(?<depName>[^\"/]+/[^\"/]+?)(?:\\.git)?\";\\s*requirement = \\{\\s*kind = \\w+;\\s*minimumVersion = (?<currentValue>[^;]+);"
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    }
  ]
}
