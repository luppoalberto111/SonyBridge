{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "branchPrefix": "renovate/",
  "prCreation": "immediate",
  "prHourlyLimit": 0,
  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "automerge": false,
      "prConcurrentLimit": 10
    }
  ]
}
